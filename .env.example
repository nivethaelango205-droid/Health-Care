# RuralCare 360 Frontend Environment Configuration
# API Base URL (defaults to /api which proxies to http://127.0.0.1:4000)
VITE_API_BASE_URL=/api

# Demo mode toggle (set false to enforce real backend connectivity)
VITE_DEMO_MODE=true

# Optional local demo-account quick login; leave blank for published builds.
# Actual passwords belong only in the ignored local .env file.
VITE_DEMO_PATIENT_PASSWORD=
VITE_DEMO_DOCTOR_PASSWORD=
VITE_DEMO_ADMIN_PASSWORD=

