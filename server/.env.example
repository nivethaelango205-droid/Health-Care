NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DATABASE_PATH=./data/ruralcare.sqlite
# Generate independent random secrets. Never commit actual values.
AUTH_SECRET=
# Exactly 64 hexadecimal characters (32 bytes). Keep this key to decrypt records.
RECORD_ENCRYPTION_KEY=
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_HOURS=12
STUN_URLS=stun:stun.l.google.com:19302
# Optional owned TURN service. Credentials are shared with authorized participants.
TURN_URLS=
TURN_USERNAME=
TURN_PASSWORD=
# Development-only seed script reads these values; runtime never creates demo users.
DEMO_PATIENT_PASSWORD=
DEMO_DOCTOR_PASSWORD=
DEMO_ADMIN_PASSWORD=
# Real Generative AI Assistant configuration (optional; leave empty for safety-verified Guided Assistance fallback)
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini
